[Unit]
Description=VortexBrowser CachyOS CachyOS Linux (1080p@25fps) Server for AmigaOS 4
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=tears
WorkingDirectory=$HOME/Server-CachyOS-Linux
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=4
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=$HOME/Server-CachyOS-Linux/run_server.sh
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
