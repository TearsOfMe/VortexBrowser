[Unit]
Description=VortexBrowser Server for AmigaOS 4 (Intel Edition)
After=network-online.target sound.target pipewire.service pulseaudio.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/VortexBrowser/Server-Intel
ExecStart=%h/VortexBrowser/Server-Intel/run_intel.sh
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
Nice=-5

[Install]
WantedBy=default.target
